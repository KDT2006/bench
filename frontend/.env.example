# Execution proxy, including the API path prefix.
# VITE_API_BASE_URL=http://127.0.0.1:8080/api

# Place these in frontend/.env.local, alongside vite.config.ts, then restart Vite.
# GEMINI_API_KEY is required for translation. Never use a VITE_ prefix for this server-only key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
